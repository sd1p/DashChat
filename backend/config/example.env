# ----------------------------------------------------------------------------
# DashChat backend environment configuration
# Copy this file to ".env" (in this same backend/config directory) and fill in
# real values. server.ts loads it via: dotenv.config({ path: "backend/config/.env" })
# In hosted deploys (Render) there is no .env file — set these in the dashboard.
# ----------------------------------------------------------------------------

# Port the Express (REST API) server listens on. Realtime is served by Hermes,
# not this backend. Local: 5001. On Render, Render injects PORT — server.ts reads it.
PORT=5001

# Node environment.
NODE_ENV=development

# --- Database (Postgres / Supabase) ---
# DATABASE_URL: runtime connection. Use Supabase's transaction-mode pooler
# (port 6543, pgbouncer=true) — this is what PrismaClient uses via the pg adapter.
DATABASE_URL=postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL: session-mode connection (port 5432). Used ONLY by the Prisma CLI
# for migrations (`prisma migrate deploy`) — pgbouncer transaction mode can't
# run migrations. Locally, if you don't use a pooler, set it to DATABASE_URL.
DIRECT_URL=postgresql://USER:PASS@HOST:5432/postgres

# --- Argus (OIDC identity provider) ---
# Origin of the Argus deployment. The backend verifies incoming Bearer tokens
# (Argus-issued JWTs) against Argus's JWKS at ${ARGUS_ISSUER}/api/auth/jwks.
# No secret is needed here — verification uses Argus's PUBLIC keys.
ARGUS_ISSUER=http://localhost:3000
# Optional: expected `aud` claim on tokens. Defaults to ARGUS_ISSUER if unset.
# ARGUS_AUDIENCE=http://localhost:3000

# --- Hermes (realtime service) ---
# The backend fans out realtime events (message notifications, chat-room grants)
# by calling Hermes's server-to-server REST API (POST /api/emit) with this
# tenant's apiKey. It does NOT run a socket server or connect to Hermes's Redis.
HERMES_URL=https://socket.sudipmandal.com
# The dashchat tenant apiKey registered in Hermes's TENANTS (server-only secret,
# never shipped to browsers). Get it from the Hermes deployment's env.
HERMES_API_KEY=your-dashchat-tenant-apikey

# --- AWS S3 (image uploads) ---
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=your-bucket
